{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make all",
            "type": "shell",
            "command": "make",
            "args": ["all"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "make gen",
            "type": "shell",
            "command": "make",
            "args": ["gen"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "make gendebug",
            "type": "shell",
            "command": "make",
            "args": ["gendebug"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
